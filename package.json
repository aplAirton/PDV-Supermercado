{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "dev:turbo": "next dev --turbo",
    "dev:poll": "next dev --experimental-watcher",
    "lint": "next lint",
    "start": "next start",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 --timeout 30000 && electron .\"",
    "electron:dev:simple": "start /B npm run dev && timeout /t 15 /nobreak >nul && electron .",
    "build:electron": "next build && electron-builder",
    "build:electron:win": "next build && electron-builder --win",
    "build:electron:linux": "next build && electron-builder --linux",
    "build:electron:mac": "next build && electron-builder --mac",
    "dist": "npm run build:electron",
    "dist:win": "npm run build:electron:win",
    "dist:linux": "npm run build:electron:linux",
    "dist:mac": "npm run build:electron:mac",
    "clean": "echo '🧹 Limpando processos e cache...' && (taskkill /F /IM node.exe /T 2>nul || echo 'Nenhum processo Node.js encontrado') && (rmdir /S /Q .next 2>nul || echo 'Diretório .next não encontrado') && npm cache clean --force 2>nul || echo 'Cache limpo'",
    "dev:clean": "npm run clean && echo '📦 Reinstalando dependências...' && npm install && echo '🚀 Iniciando desenvolvimento...' && npm run dev"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@prisma/client": "^6.14.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@zxing/browser": "^0.1.5",
    "@zxing/library": "^0.21.3",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "embla-carousel-react": "8.5.1",
    "geist": "^1.3.1",
    "input-otp": "1.4.1",
    "lucide-react": "^0.454.0",
    "mysql2": "latest",
    "next": "^15.4.6",
    "next-themes": "^0.4.6",
    "prisma": "^6.14.0",
    "quagga": "^0.12.1",
    "react": "^19.1.1",
    "react-day-picker": "9.8.0",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.4",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "3.25.67",
    "electron": "^33.0.0",
    "electron-builder": "^26.0.0",
    "concurrently": "^9.0.0",
    "wait-on": "^8.0.0"
  },
  "main": "electron/main.js",
  "homepage": "./",
  "build": {
    "appId": "com.pdvsupermercado.app",
    "productName": "PDV Supermercado",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.9",
    "@types/node": "^22",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "postcss": "^8.5",
    "tailwindcss": "^4.1.9",
    "tw-animate-css": "1.3.3",
    "typescript": "^5"
  }
}
